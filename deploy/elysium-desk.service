[Unit]
Description=Elysium paper copy desk and dashboard
After=network-online.target
Wants=network-online.target

[Service]
# Adjust User/Group/WorkingDirectory to the checkout owner and path.
User=elysium
Group=elysium
WorkingDirectory=/opt/elysium
EnvironmentFile=/opt/elysium/.env
ExecStart=/opt/elysium/.venv/bin/python -m elys serve --host 127.0.0.1 --port 18086
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
