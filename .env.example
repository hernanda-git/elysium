# Copy this file to .env and adjust. Nothing here is secret; keep .env out of git.

# ── data plane ────────────────────────────────────────────────────────────────
ELYS_INTEL_BASE=https://api.elysium.eco
ELYS_RPC_URL=https://rpc.elysium.kinetiq.xyz
ELYS_DB=data/elys.db
ELYS_LOG=data/elys.log

# ── paper account ─────────────────────────────────────────────────────────────
ELYS_START_EQUITY=1000
ELYS_PER_TRADE_USD=25
ELYS_MAX_POSITIONS=8
ELYS_MAX_WATCH=32
ELYS_MAX_TOKEN_USD=50
ELYS_MAX_DAILY_LOSS_PCT=0.10
ELYS_MAX_ADDS_PER_TOKEN=2

# ── execution model (paper) ───────────────────────────────────────────────────
ELYS_SLIPPAGE_BPS=150
ELYS_FEE_BPS=50

# ── copy rules ────────────────────────────────────────────────────────────────
ELYS_MIN_WHALE_USD=250
ELYS_MIN_LIQ_USD=15000
ELYS_MAX_TOP10_PCT=45
ELYS_MIN_TOKEN_AGE_S=60
ELYS_COPY_SELLS=true
ELYS_IGNORE_SYMBOLS=WHYPE,HYPE,USDC,USDT,USDe

# ── exits ─────────────────────────────────────────────────────────────────────
ELYS_STOP_LOSS_PCT=0.35
ELYS_TAKE_PROFIT_PCT=1.50
ELYS_TRAIL_ARM_PCT=0.60
ELYS_TRAIL_GIVEBACK_PCT=0.30
ELYS_MAX_HOLD_MIN=240

# ── discovery screen ──────────────────────────────────────────────────────────
ELYS_DISCOVER_WINDOWS=1d,7d,30d
ELYS_DISCOVER_LIMIT=300
ELYS_DISCOVER_MIN_TRADES=20
ELYS_DISCOVER_MIN_TOKENS=3
ELYS_DISCOVER_MIN_REALIZED=500
ELYS_DISCOVER_MIN_WR=0.50
ELYS_DISCOVER_PROFILES=120
ELYS_DISCOVER_PROBE_TRADES=60
ELYS_DISCOVER_MAX_IDLE_S=3600
ELYS_DISCOVER_MIN_RECENT_BUYS=1

# ── monitoring ────────────────────────────────────────────────────────────────
ELYS_POLL_INTERVAL_S=20
ELYS_REBALANCE_HOURS=6
ELYS_STREAM=true

# ── web dashboard (HTTP Basic; leave password empty for local dev)
ELYS_WEB_USER=elys
ELYS_WEB_PASSWORD=

# ── telegram (public channel; optional Telethon login) ────────────────────────
ELYS_TG_CHANNEL=elysiumecoalerts
ELYS_TG_INTERVAL_S=5
# Reused by other bots on this machine; only needed for `elys tg listen`.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
