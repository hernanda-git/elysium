# Copy this file to .env and adjust. Nothing here is secret; keep .env out of git.

# ── data plane ────────────────────────────────────────────────────────────────
ELYS_INTEL_BASE=https://api.elysium.eco
ELYS_RPC_URL=https://rpc.elysium.kinetiq.xyz
ELYS_DB=data/elys.db
ELYS_LOG=data/elys.log

# ── paper account ─────────────────────────────────────────────────────────────
ELYS_START_EQUITY=1000
ELYS_PER_TRADE_USD=25
ELYS_MAX_POSITIONS=8
ELYS_MAX_WATCH=32
ELYS_MAX_TOKEN_USD=50
ELYS_MAX_DAILY_LOSS_PCT=0.10
ELYS_MAX_ADDS_PER_TOKEN=2

# ── execution model (paper) ───────────────────────────────────────────────────
# Flat friction per side plus constant-product impact (usd / pool liquidity).
# Fills use the market price at detection, not the whale's stale fill price.
ELYS_SLIPPAGE_BPS=50
ELYS_FEE_BPS=50
ELYS_MAX_IMPACT_BPS=500
ELYS_FILL_AT_MARKET=true

# ── copy rules ────────────────────────────────────────────────────────────────
ELYS_MIN_WHALE_USD=250
ELYS_MIN_LIQ_USD=15000
ELYS_MAX_TOP10_PCT=45
ELYS_MIN_TOKEN_AGE_S=60
ELYS_COPY_SELLS=true
ELYS_IGNORE_SYMBOLS=WHYPE,HYPE,USDC,USDT,USDe
# retrace: rest a limit at the whale's fill, fill only on the retrace, exit into
# the next buy. market: fill immediately at detection price (no-chase gate 3 %).
ELYS_ENTRY_MODE=retrace
ELYS_RETRACE_LIMIT_PCT=0.02
ELYS_RETRACE_TTL_S=180
ELYS_POP_EXIT=true
ELYS_MAX_CHASE_PCT=0.03
ELYS_MAX_SIGNAL_LATENCY_S=180
ELYS_MAX_TRADE_LIQ_PCT=0.01
ELYS_REENTRY_GUARD_S=600
ELYS_STOP_COOLDOWN_S=21600
# Independent evidence required on top of the whale print.
ELYS_MIN_COPY_SCORE=55
ELYS_CONVICTION_WINDOW_S=600
ELYS_MIN_CONVICTION_WALLETS=2
ELYS_MAX_WALLET_TRADES=5000
ELYS_MAX_WALLET_TRADES_PER_TOKEN=300
ELYS_MIN_MCAP_USD=100000
ELYS_MAX_UNDERWATER_PCT=95
ELYS_MAX_CLUSTERS=3
ELYS_MAX_INSIDER_PCT=20
ELYS_MIN_BUY_RATIO=0.55
ELYS_MIN_VOL_ACCEL=1.5

# ── strategy selection ────────────────────────────────────────────────────────
# Copy fills are disabled by default: the archived forward sample shows copied
# entries lose after realistic market-at-detection execution. Whale prints are
# still monitored and logged as flow information.
ELYS_COPY_ENABLED=false
ELYS_MOMENTUM=true

# ── volume-climax screener ────────────────────────────────────────────────────
# One universe request per interval; the screen uses the API's rolling volume,
# buy/sell and net-flow fields. Entries require a 5m volume climax, positive
# 1h return and quality gates; exits use a tighter stop and a trailing stop.
ELYS_MOMENTUM_INTERVAL_S=30
ELYS_MOMENTUM_UNIVERSE=200
ELYS_MOMENTUM_MIN_MCAP_USD=100000
ELYS_MOMENTUM_MIN_LIQ_USD=15000
ELYS_MOMENTUM_MIN_VOL_1H_USD=1000
ELYS_MOMENTUM_MIN_AGE_S=1800
ELYS_MOMENTUM_MIN_ACCEL=1.5
ELYS_MOMENTUM_MIN_BUY_RATIO=0.55
ELYS_MOMENTUM_MIN_CHG_1H=0.0
ELYS_MOMENTUM_MAX_CHG_1H=0.30
ELYS_MOMENTUM_MAX_POSITIONS=3
ELYS_MOMENTUM_PER_TRADE_USD=25
ELYS_MOMENTUM_MAX_NEW_PER_SCAN=2
ELYS_MOMENTUM_COOLDOWN_S=3600
ELYS_MOMENTUM_STOP_LOSS_PCT=0.10
ELYS_MOMENTUM_TAKE_PROFIT_PCT=1.50
ELYS_MOMENTUM_TRAIL_ARM_PCT=0.10
ELYS_MOMENTUM_TRAIL_GIVEBACK_PCT=0.30
ELYS_MOMENTUM_MAX_HOLD_MIN=120

# ── exits ─────────────────────────────────────────────────────────────────────
ELYS_STOP_LOSS_PCT=0.35
ELYS_TAKE_PROFIT_PCT=1.50
ELYS_TRAIL_ARM_PCT=0.60
ELYS_TRAIL_GIVEBACK_PCT=0.30
ELYS_MAX_HOLD_MIN=240
ELYS_IMPAIRED_HAIRCUT_PCT=0.90

# ── discovery screen ──────────────────────────────────────────────────────────
ELYS_DISCOVER_WINDOWS=1d,7d,30d
ELYS_DISCOVER_LIMIT=300
ELYS_DISCOVER_MIN_TRADES=20
ELYS_DISCOVER_MIN_TOKENS=3
ELYS_DISCOVER_MIN_REALIZED=500
ELYS_DISCOVER_MIN_WR=0.50
ELYS_DISCOVER_PROFILES=120
ELYS_DISCOVER_PROBE_TRADES=60
ELYS_DISCOVER_MAX_IDLE_S=3600
ELYS_DISCOVER_MIN_RECENT_BUYS=1
ELYS_SEED_PATH=seed/whales.json

# ── monitoring ────────────────────────────────────────────────────────────────
ELYS_POLL_INTERVAL_S=5
ELYS_REBALANCE_HOURS=6
ELYS_STREAM=true

# ── web dashboard (HTTP Basic; leave password empty for local dev)
ELYS_WEB_USER=elys
ELYS_WEB_PASSWORD=

# ── telegram (public channel; optional Telethon login) ────────────────────────
ELYS_TG_CHANNEL=elysiumecoalerts
ELYS_TG_INTERVAL_S=5
# Reused by other bots on this machine; only needed for `elys tg listen`.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
